                <mxCell id="1003" value="&lt;b&gt;All modules: approved specs + BDD tests&lt;/b&gt;&lt;br&gt;Human has reviewed every abstraction level top-down" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" parent="1" vertex="1">
