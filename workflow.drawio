                <mxCell id="406" value="&lt;b&gt;Characterization Tests (in repo)&lt;/b&gt;&lt;br&gt;• Golden-file or assertion-based tests&lt;br&gt;• Behavioral oracle for the new implementation&lt;br&gt;• Rerun against new impl to verify equivalence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;arcSize=3;fontSize=11;" parent="1" vertex="1">
