                <mxCell id="1000" value="&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;PHASE 2 — BDD Review Loop&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="390" y="1538" width="560" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="1001" value="&lt;b&gt;STAGE 6 — BDD Specification &amp;amp; Testing&lt;/b&gt;&lt;br&gt;Skills: &lt;i&gt;bdd-review-loop&lt;/i&gt; + &lt;i&gt;bdd-writing-quality&lt;/i&gt;&lt;br&gt;Traverses plan tree &lt;b&gt;breadth-first (top-down)&lt;/b&gt;. Writes BDD specs for all siblings at each level.&lt;br&gt;Delegates to bdd-spec-writer (specs) and bdd-test-writer (tests)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=12;arcSize=5;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="410" y="1578" width="510" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="1010" value="&lt;b&gt;specs/*.md&lt;/b&gt;&lt;br&gt;• Gherkin-style BDD scenarios per module&lt;br&gt;• Interface contracts as executable specifications&lt;br&gt;• Approved by human before tests are written" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;arcSize=3;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="960" y="1578" width="360" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="1011" value="&lt;b&gt;tests/ (BDD tests)&lt;/b&gt;&lt;br&gt;• Executable tests implementing approved specs&lt;br&gt;• Primary acceptance mechanism for implementation&lt;br&gt;• Written after human approval of sibling specs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;arcSize=3;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="960" y="1670" width="360" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="1002" value="&lt;b&gt;Human Gate (per level)&lt;/b&gt;&lt;br&gt;Reviews sibling specs together · approves or requests revision&lt;br&gt;Interface incompatibilities caught at the abstraction boundary" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="440" y="1730" width="450" height="90" as="geometry"/>
