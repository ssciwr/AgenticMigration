                <mxCell id="405" value="&lt;b&gt;Oracle Review Document&lt;/b&gt;&lt;br&gt;• Missing modules, unclear scope, overlaps&lt;br&gt;• Underdefined interface contracts, hidden dependencies&lt;br&gt;• Unaddressed characterization findings&lt;br&gt;• Alternative decompositions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;arcSize=3;fontSize=11;" parent="1" vertex="1">
