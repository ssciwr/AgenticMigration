                <mxCell id="2000" value="PHASE 3 — Implementation Loop" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="390" y="1952" width="560" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="2001" value="&lt;b&gt;STAGE 7 — Implementation&lt;/b&gt;&lt;br&gt;Agents: &lt;i&gt;worker&lt;/i&gt; + &lt;i&gt;reviewer&lt;/i&gt;  ·  Skill: &lt;i&gt;implementation-loop&lt;/i&gt;&lt;br&gt;Traverses plan tree &lt;b&gt;bottom-up&lt;/b&gt;. Per module: worker implements → BDD tests run → reviewer checks.&lt;br&gt;Iterates until tests pass and reviewer has no blocking issues. Decisions on gaps are documented." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;arcSize=5;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="410" y="1992" width="510" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="2010" value="&lt;b&gt;implementation-reports/*.md (or PR descriptions)&lt;/b&gt;&lt;br&gt;• What was implemented · BDD test results&lt;br&gt;• Decisions made on underspecified cases (rationale)&lt;br&gt;• Items requiring human confirmation flagged explicitly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;arcSize=3;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="960" y="1992" width="360" height="90" as="geometry"/>
