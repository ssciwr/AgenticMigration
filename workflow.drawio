                <mxCell id="2000" value="PHASE 3 — Implementation Loop" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="690" y="1962" width="560" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="2001" value="&lt;b&gt;STAGE 7 — Implementation&lt;/b&gt;&lt;br&gt;Agents: &lt;i&gt;worker&lt;/i&gt; + &lt;i&gt;reviewer&lt;/i&gt;  ·  Skill: &lt;i&gt;implementation-loop&lt;/i&gt;&lt;br&gt;Traverses plan tree &lt;b&gt;bottom-up&lt;/b&gt;. Per module: worker implements → BDD tests + unit/integration tests run.&lt;br&gt;Reviewer checks: BDD pass · unit/integration pass · dependency_interface compliance. Iterates until all pass." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;arcSize=5;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="410" y="1992" width="510" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="2010" value="&lt;b&gt;implementation-reports/*.md (or PR descriptions)&lt;/b&gt;&lt;br&gt;• BDD test results · unit/integration test results&lt;br&gt;• Dependency interface compliance per dependency_interface entry&lt;br&gt;• Decisions made on underspecified cases (rationale)&lt;br&gt;• Items requiring human confirmation flagged explicitly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;arcSize=3;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="960" y="1992" width="360" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="2002" value="&lt;b&gt;Human Gate (per level)&lt;/b&gt;&lt;br&gt;Reviews implementation reports · resolves flagged decisions&lt;br&gt;Approves before ascending to next level of the plan tree" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="440" y="2150" width="450" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="2003" value="&lt;b&gt;OUTPUT: Migrated Codebase&lt;/b&gt;&lt;br&gt;BDD tests + unit/integration tests passing · dependency interfaces verified · human-approved at every level" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#333333;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="445" y="2300" width="440" height="60" as="geometry"/>
