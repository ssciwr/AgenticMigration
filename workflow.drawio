                </mxCell>
                <mxCell id="800" value="&lt;b&gt;END OF DISCOVERY CHAIN&lt;/b&gt;&lt;br&gt;Human reviews oracle findings. node_type and dependency_interfaces resolved for every module.&lt;br&gt;Plan is ready for the BDD specification and review loop." style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="425" y="1450" width="480" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="1000" value="&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;PHASE 2 — Specification &amp;amp; Intent Review Loop&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="390" y="1538" width="560" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="1001" value="&lt;b&gt;STAGE 6 — Specification &amp;amp; Intent Review (breadth-first)&lt;/b&gt;&lt;br&gt;Skills: &lt;i&gt;bdd-review-loop&lt;/i&gt; + &lt;i&gt;bdd-writing-quality&lt;/i&gt;&lt;br&gt;Human discovers &amp;amp; approves intent grounded in characterization findings. Breadth-first level-by-level.&lt;br&gt;&lt;b&gt;bdd-spec-writer:&lt;/b&gt; interface contract spec (.md) for leaf nodes; Gherkin .feature for integration nodes.&lt;br&gt;&lt;b&gt;worker:&lt;/b&gt; unit tests (leaf) or BDD step defs + integration tests (integration). Approved before tests written." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=12;arcSize=5;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="410" y="1578" width="510" height="106" as="geometry"/>
                </mxCell>
                <mxCell id="1010" value="&lt;b&gt;specs/ — Approved specifications (per module)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Leaf nodes:&lt;/b&gt; interface contract spec (.md) — intent, behavior dispositions, typed interface, framework protocols&lt;br&gt;• &lt;b&gt;Integration nodes:&lt;/b&gt; Gherkin .feature — BDD scenarios + dependency interface coverage section&lt;br&gt;• Human-approved before tests are written" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;arcSize=3;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="960" y="1586" width="360" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="1011" value="&lt;b&gt;tests/ — Executable test surface (per module)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Leaf nodes:&lt;/b&gt; unit tests (native framework) covering interface contracts &amp;amp; dependency_interfaces&lt;br&gt;• &lt;b&gt;Integration nodes:&lt;/b&gt; BDD step definitions + integration tests verifying child module composition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;arcSize=3;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="960" y="1745" width="360" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="1002" value="&lt;b&gt;Human Gate (per level)&lt;/b&gt;&lt;br&gt;Reviews sibling specs together · confirms dependency_interface coverage&lt;br&gt;Interface incompatibilities caught at abstraction boundary · approves before tests are written" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="440" y="1740" width="450" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="1003" value="&lt;b&gt;All modules: approved specs + unit/integration tests&lt;/b&gt;&lt;br&gt;Interface contracts (leaf) and Gherkin features (integration) human-reviewed top-down; dependency interfaces covered" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="435" y="1888" width="460" height="54" as="geometry"/>
