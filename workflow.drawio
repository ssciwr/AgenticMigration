                <mxCell id="403" value="&lt;b&gt;requirements.md&lt;/b&gt;&lt;br&gt;• Scope, user base, architectural requirements&lt;br&gt;• Behavioral requirements (entry points, delivery, interfaces)&lt;br&gt;• Dependencies, output repo, characterization decisions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;arcSize=3;fontSize=11;" parent="1" vertex="1">
