                <mxCell id="401" value="&lt;b&gt;characterization-report.md&lt;/b&gt;&lt;br&gt;• Behavior inventory: ID, Evidence, Status, Confidence&lt;br&gt;• Current-behavior examples (Gherkin-like observations)&lt;br&gt;• Decision candidates · Risks &amp; limits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;arcSize=3;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="960" y="200" width="360" height="86" as="geometry"/>
